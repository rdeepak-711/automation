# WordPress site credentials — copy to .env and fill in values
# NEVER commit .env to git

WP_SITE_URL=https://yoursite.com
WP_USER=admin
WP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx
GeneratePress_license_key="your-generatepress-license-key"

# SSH credentials (required for zip plugin installs via WP-CLI)
# Bluehost shared hosting: SSH host is your server IP, user is your cPanel username
WP_SSH_HOST=your-server-ip
WP_SSH_USER=your-cpanel-username
WP_SSH_KEY=~/.ssh/id_rsa
# WP_PATH is auto-discovered via Step 1 — only set manually if discovery fails
# WP_PATH=/home1/yourusername/public_html/website_yoursite

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Path to the WordPress XML export for GP Elements import
# Relative paths are resolved from the auto-create-site root.
GP_ELEMENTS_XML=input/gp-elements.xml

# File paths for the logo and favicon to upload
logo_path=/path/to/your/logo.png
favicon_path=/path/to/your/favicon.ico

GYG_API_KEY=your_getyourguide_partner_api_key

# ── Layout (Step 6) ───────────────────────────────────────────────────────────
# These have sensible defaults — only set if you need to override
# CONTAINER_WIDTH=1365    # px — overall site max-width

# ── Colors (Step 7) ──────────────────────────────────────────────────────────
# BODY_BG_COLOR=ffffff    # hex without # — body background color

# ── Typography (Step 8) ──────────────────────────────────────────────────────
# FONT_NAME=Karla         # Google Font name (must exist on fonts.googleapis.com)
# BODY_FONT_SIZE=18       # px
# BODY_LINE_HEIGHT=1.6    # unitless
# PARAGRAPH_MARGIN=1.5    # em
# H1_FONT_SIZE=35         # px
# H2_FONT_SIZE=32         # px
# H3_FONT_SIZE=28         # px
# H4_FONT_SIZE=24         # px

# ── Appearance (Step 5) ──────────────────────────────────────────────────────
# LOGO_WIDTH=320          # px — logo display width in header
